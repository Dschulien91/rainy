# Copy to .env and fill in. The domain's DNS A record must point to this server's IP.
DOMAIN=hellorainy.com
# Local cache for weather model data (raise on servers with more RAM/disk)
OPENMETEO_CACHE=8GB

# ---- Optional login (sync of favourites and settings). Leave a block empty to switch that sign-in method off. ----
# Signs the short-lived OAuth state cookie. Generate once: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# Google sign-in (OpenID Connect): Google Cloud console > APIs & Services > Credentials > OAuth client ID (web app).
# Authorised redirect URI: https://<DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email sign-in link: SMTP account of the sending mailbox (port 465 = SMTPS, 587 = STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=rainy <hey@hellorainy.com>
