# One domain for everything: the app, /api + /tiles (radar server) and /om (self-hosted Open-Meteo).
# Caddy obtains and renews the HTTPS certificate automatically. No access logs are written.
# www.<domain> only redirects to the main domain
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		-Server
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		# not public yet: no search engine indexing (remove at launch, together with the noindex meta in index.html)
		X-Robots-Tag "noindex, nofollow"
	}

	# Languages: one folder per language (/de/, /en/). Only the bare domain picks one: the language the user chose
	# (cookie rainy_lang, set by the switcher), else German for browsers that prefer German, else English. Deep links
	# are never redirected (search engines crawl without Accept-Language). New language: add it here and in the switcher.
	# (a "handle /" block, not a bare "route": Caddy runs route after handle, so the file server would answer first;
	# the route inside keeps the checks in this order)
	handle / {
		@chosenDe header Cookie *rainy_lang=de*
		@chosenEn header Cookie *rainy_lang=en*
		@browserDe header_regexp Accept-Language ^\s*de
		route {
			header Vary "Accept-Language, Cookie"
			redir @chosenDe /de/ 302
			redir @chosenEn /en/ 302
			redir @browserDe /de/ 302
			redir * /en/ 302
		}
	}
	# old addresses before the /de/ folder (08.11.)
	redir /regenradar/* /de{uri} 301
	redir /impressum.html /de/impressum.html 301
	redir /datenschutz.html /de/datenschutz.html 301

	# radar server: JSON API and the map tiles (tile URLs carry the data run, so a CDN may keep them for a day)
	handle /api/* {
		reverse_proxy api:8771
	}
	# Basemap (app v1.30): OpenFreeMap's styles, fonts, sprites and vector tiles through this server - under /tiles/ so
	# the CDN rule for /tiles/* keeps them (tile URLs carry OpenFreeMap's data version). The users' browsers no longer
	# talk to a third party (no IP address, no referrer), and tiles the CDN holds survive an outage there. Nothing that
	# identifies the user or this site is passed on.
	handle_path /tiles/ofm/* {
		reverse_proxy https://tiles.openfreemap.org {
			header_up Host tiles.openfreemap.org
			header_up User-Agent "Mozilla/5.0"
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -X-Real-IP
			header_up -True-Client-IP
			header_up -CF-Connecting-IP
			header_up -CF-IPCountry
			header_up -CF-Ray
			header_up -CF-Visitor
			header_up -CDN-Loop
			header_up -Referer
			header_up -Origin
			header_up -Cookie
			header_up -Authorization
			header_down -Set-Cookie
			header_down -Access-Control-Allow-Origin
		}
		header Access-Control-Allow-Origin "*"
	}
	handle /tiles/* {
		reverse_proxy api:8771
	}

	# Europe test instance (beta): /eu/api/..., /eu/tiles/... -> api-eu (prefix stripped)
	handle_path /eu/* {
		reverse_proxy api-eu:8771
	}
	# third instance: our own Europe picture from national radar data (beta) -> api-eun
	handle_path /eun/* {
		reverse_proxy api-eun:8771
	}
	# North America (beta): NOAA MRMS radar with our nowcast -> api-na
	handle_path /na/* {
		reverse_proxy api-na:8771
	}

	# Weather model API; responses may be cached briefly by a CDN in front of this server.
	handle_path /om/* {
		reverse_proxy openmeteo:8080
		header Cache-Control "public, max-age=600"
		header Access-Control-Allow-Origin "*"
	}

	handle {
		root * /srv/app
		# only serve the app files, never the server code, tools or deployment files
		@private path /server/* /deploy/* /tools/* /.git/* /.claude/* /*.md /*.py
		respond @private 404
		# the page itself must always be fresh (new versions), the libraries rarely change
		@page path / /index.html /sw.js /de/* /en/* /sitemap.xml /robots.txt /manifest.json
		header @page Cache-Control "no-cache"
		# language files: the pages ask for lang/<code>.js?v=<app version> (tools/make_landing.py), a new version is a
		# new URL - so a returning visitor needs no round trip to check them (app v1.26); without ?v= always fresh
		@langVersioned {
			path /lang/*
			query v=*
		}
		header @langVersioned Cache-Control "public, max-age=31536000, immutable"
		@langFresh {
			path /lang/*
			not query v=*
		}
		header @langFresh Cache-Control "no-cache"
		header /vendor/* Cache-Control "public, max-age=604800"
		file_server
	}
}
