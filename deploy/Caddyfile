# One domain for everything: the app, /api + /tiles (radar server) and /om (self-hosted Open-Meteo).
# Caddy obtains and renews the HTTPS certificate automatically. No access logs are written.
# www.<domain> only redirects to the main domain
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		-Server
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		# not public yet: no search engine indexing (remove at launch, together with the noindex meta in index.html)
		X-Robots-Tag "noindex, nofollow"
	}

	# Languages: one folder per language (/de/, /en/). Only the bare domain picks one: the language the user chose
	# (cookie rainy_lang, set by the switcher), else German for browsers that prefer German, else English. Deep links
	# are never redirected (search engines crawl without Accept-Language). New language: add it here and in the switcher.
	route / {
		header Vary "Accept-Language, Cookie"
		@chosenDe header Cookie *rainy_lang=de*
		redir @chosenDe /de/ 302
		@chosenEn header Cookie *rainy_lang=en*
		redir @chosenEn /en/ 302
		@browserDe header_regexp Accept-Language ^\s*de
		redir @browserDe /de/ 302
		redir * /en/ 302
	}
	# old addresses before the /de/ folder (08.11.)
	redir /regenradar/* /de{uri} 301
	redir /impressum.html /de/impressum.html 301
	redir /datenschutz.html /de/datenschutz.html 301

	# radar server: JSON API and the map tiles (tile URLs carry the data run, so a CDN may keep them for a day)
	handle /api/* {
		reverse_proxy api:8771
	}
	handle /tiles/* {
		reverse_proxy api:8771
	}

	# Weather model API; responses may be cached briefly by a CDN in front of this server.
	handle_path /om/* {
		reverse_proxy openmeteo:8080
		header Cache-Control "public, max-age=600"
		header Access-Control-Allow-Origin "*"
	}

	handle {
		root * /srv/app
		# only serve the app files, never the server code, tools or deployment files
		@private path /server/* /deploy/* /tools/* /.git/* /.claude/* /*.md /*.py
		respond @private 404
		# the page itself must always be fresh (new versions), the libraries rarely change
		@page path / /index.html /sw.js /de/* /en/* /sitemap.xml /robots.txt /manifest.json
		header @page Cache-Control "no-cache"
		header /vendor/* Cache-Control "public, max-age=604800"
		file_server
	}
}
